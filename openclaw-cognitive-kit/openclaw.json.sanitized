{
  "meta": {
    "lastTouchedVersion": "community"
  },
  "models": {
    "mode": "merge",
    "providers": {
      "deepseek": {
        "baseUrl": "https://api.deepseek.com/v1",
        "apiKey": "YOUR_DEEPSEEK_API_KEY",
        "api": "openai-completions",
        "models": [
          {
            "id": "deepseek-chat",
            "name": "deepseek-chat"
          }
        ]
      },
      "ollama": {
        "baseUrl": "http://127.0.0.1:11434",
        "apiKey": "ollama-local",
        "api": "openai-completions",
        "_note": "memorySearch 的 embedding 服务；本机执行 ollama pull bge-m3 后生效",
        "models": [
          {
            "id": "bge-m3",
            "name": "BGE-M3 Embedding"
          }
        ]
      }
    }
  },
  "agents": {
    "defaults": {
      "model": {
        "primary": "deepseek/deepseek-chat",
        "fallbacks": []
      },
      "bootstrapMaxChars": 3000,
      "memorySearch": {
        "enabled": true,
        "provider": "ollama",
        "model": "bge-m3",
        "_note": "需本机 ollama + bge-m3；不想装本地模型就把 enabled 改 false"
      },
      "maxConcurrent": 2
    },
    "list": [
      {
        "id": "main"
      }
    ]
  },
  "gateway": {
    "port": 18789,
    "mode": "local",
    "bind": "loopback",
    "auth": {
      "mode": "token",
      "token": "YOUR_GATEWAY_TOKEN"
    },
    "http": {
      "endpoints": {
        "responses": {
          "enabled": true
        }
      }
    }
  },
  "plugins": {
    "allow": [
      "v15-cognitive-hook"
    ],
    "entries": {
      "v15-cognitive-hook": {
        "enabled": false,
        "_note": "开启前先跑 python3 ~/.openclaw/workspace/scripts/v15/cognitive-core-v15.py --analyze \"测试\" 确认输出 ok=true；详见 extensions/v15-cognitive-hook/README.md",
        "config": {
          "timeoutMs": 1200,
          "maxContextChars": 1200
        },
        "hooks": {
          "allowPromptInjection": true
        }
      }
    }
  }
}
