{
  "name": "content-studio",
  "version": "1.0.0",
  "description": "统一内容创作 — 文生图/文生视频/图生图/图生视频/首尾帧生视频 + 飞书文件直发",
  "author": "圆规",
  "tags": ["image", "video", "content", "feishu", "seedream", "seedance"],
  "commands": [
    {
      "name": "check",
      "description": "健康检查",
      "script": "scripts/content_studio.py",
      "args": ["check"]
    },
    {
      "name": "text2image",
      "description": "文生图: 文字描述生成图片并发送到飞书",
      "script": "scripts/content_studio.py",
      "args": ["text2image"],
      "params": {
        "prompt": {"type": "string", "required": true, "description": "图片描述"},
        "engine": {"type": "string", "enum": ["seedream5", "wanx"], "default": "seedream5"},
        "size": {"type": "string", "default": "2K"},
        "feishu_target": {"type": "string", "description": "飞书接收者ID (open_id/chat_id)"}
      }
    },
    {
      "name": "text2video",
      "description": "文生视频: 文字描述生成视频并发送到飞书",
      "script": "scripts/content_studio.py",
      "args": ["text2video"],
      "params": {
        "prompt": {"type": "string", "required": true, "description": "视频描述"},
        "ratio": {"type": "string", "enum": ["16:9","9:16","1:1","4:3","3:4"], "default": "16:9"},
        "duration": {"type": "integer", "min": 4, "max": 15, "default": 5},
        "resolution": {"type": "string", "enum": ["480p","720p"], "default": "720p"},
        "feishu_target": {"type": "string"}
      }
    },
    {
      "name": "image2image",
      "description": "图生图: 参考图+描述生成新图片",
      "script": "scripts/content_studio.py",
      "args": ["image2image"],
      "params": {
        "ref_image": {"type": "string", "required": true, "description": "参考图片路径"},
        "prompt": {"type": "string", "required": true, "description": "创作描述"},
        "feishu_target": {"type": "string"}
      }
    },
    {
      "name": "image2video",
      "description": "图生视频: 图片作为首帧生成视频",
      "script": "scripts/content_studio.py",
      "args": ["image2video"],
      "params": {
        "ref_image": {"type": "string", "required": true, "description": "首帧图片路径"},
        "prompt": {"type": "string", "description": "运动描述"},
        "feishu_target": {"type": "string"}
      }
    },
    {
      "name": "frames2video",
      "description": "首尾帧生视频: 首帧+尾帧生成过渡视频",
      "script": "scripts/content_studio.py",
      "args": ["frames2video"],
      "params": {
        "first_frame": {"type": "string", "required": true, "description": "首帧图片"},
        "last_frame": {"type": "string", "required": true, "description": "尾帧图片"},
        "prompt": {"type": "string", "description": "过渡描述"},
        "feishu_target": {"type": "string"}
      }
    }
  ]
}
